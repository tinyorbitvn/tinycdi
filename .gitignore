# Local tools, experiments, execution ledger and secrets
/work/
/.superpowers/
# SEC-45: secrets must never land in the working tree — env files, key
# material and kubeconfigs are ignored at any depth.
.env*
!.env.example
secret/
*.key
*.pem
*kubeconfig*
*.qcow2
*.vhd
*.vhdx
*.iso

