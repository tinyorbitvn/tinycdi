{
  "name": "tinycdi-web",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "tinycdi workspace portal — React/TypeScript UI over the public OpenAPI contract",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/write-third-party-licenses.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript ../internal/api/openapi.yaml -o src/api/generated/schema.d.ts",
    "lint:strings": "node scripts/check-jsx-literals.mjs",
    "test": "npm run lint:strings && vitest run && playwright test && playwright test --config playwright.portal.config.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test && playwright test --config playwright.portal.config.ts",
    "test:e2e:portal": "playwright test --config playwright.portal.config.ts",
    "mock-api": "node --disable-warning=ExperimentalWarning tests/mock-api/server.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.2"
  }
}
