<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <!-- Compositing off: no GPU in the session, and a software
         compositor costs CPU on every frame KasmVNC has to encode. -->
    <property name="use_compositing" type="bool" value="false"/>
    <property name="theme" type="string" value="Greybird"/>
    <property name="title_font" type="string" value="DejaVu Sans Bold 10"/>
    <property name="workspace_count" type="int" value="1"/>
    <property name="show_dock_shadow" type="bool" value="false"/>
    <property name="show_frame_shadow" type="bool" value="false"/>
    <property name="show_popup_shadow" type="bool" value="false"/>
    <property name="double_click_action" type="string" value="maximize"/>
    <property name="easy_click" type="string" value="none"/>
  </property>
</channel>
